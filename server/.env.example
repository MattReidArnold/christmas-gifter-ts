# Copy to server/.env. The server refuses to start when BETTER_AUTH_SECRET is missing.
# Generate a secret with: openssl rand -base64 32
# Leave the Google values empty until you have an OAuth client. Google sign-in stays off until both are set.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud OAuth client (Web application). See README "Google sign-in".
# Localhost origin: http://localhost:3000
# Localhost redirect: http://localhost:3000/api/auth/callback/google
# Cloud Run uses the public https host for BETTER_AUTH_URL, the JavaScript origin, and the redirect.
